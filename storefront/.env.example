NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional server-side catalogue origin (defaults to NEXT_PUBLIC_API_URL)
# CATALOGUE_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=https://elvarqo.uk
# Keep local and staging false. On the live elvarqo.uk app set true at build AND runtime.
# Indexing additionally requires NODE_ENV=production and NEXT_PUBLIC_SITE_URL=https://elvarqo.uk.
STOREFRONT_INDEXING=false

# Server-only guest bag proxy. These must agree with backend STOREFRONT_ORIGIN.
COMMERCE_API_URL=http://localhost:8000/api/v1
STOREFRONT_ORIGIN=http://localhost:3000
