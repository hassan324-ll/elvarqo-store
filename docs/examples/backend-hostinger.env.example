# STAGING ONLY: placeholders, not a deployable/live configuration.
# Start from backend/.env.example, then apply these values in a private server .env.
APP_ENV=staging
APP_DEBUG=false
# If copying encrypted records, use the original APP_KEY privately. Do not generate a new key.
APP_KEY=
APP_URL=https://api-staging.elvarqo.uk
STOREFRONT_ORIGIN=https://staging.elvarqo.uk
STAFF_ADMIN_ORIGIN=https://admin-staging.elvarqo.uk
CORS_ALLOWED_ORIGINS=https://staging.elvarqo.uk,https://admin-staging.elvarqo.uk
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_HPANEL_DATABASE
DB_USERNAME=REPLACE_WITH_HPANEL_USER
DB_PASSWORD=
DB_TIMEZONE=+00:00
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_DRIVER=database
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
LOG_LEVEL=warning
MAIL_MAILER=log
PAYMENT_PROVIDER=wise_bank_transfer
WISE_ENABLED=false
WISE_ACCOUNT_HOLDER=
WISE_SORT_CODE=
WISE_ACCOUNT_NUMBER=
STRIPE_SANDBOX_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Native image processing: GD must include JPEG, PNG and WebP support.
MEDIA_IMAGE_DRIVER=gd
# No Node subprocess is used by the API in GD mode. Next.js is a separate Node app.
