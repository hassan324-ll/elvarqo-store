APP_NAME=ELVARQO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
BUSINESS_TIMEZONE=Europe/London
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=sqlite
# Default path: backend/database/database.sqlite. Override DB_DATABASE with an absolute path if needed.
# MySQL/MariaDB staging: see docs/MYSQL-MIGRATION.md. Preserve existing .env and APP_KEY.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=your_private_database
# DB_USERNAME=your_private_user
# DB_PASSWORD=
# DB_TIMEZONE=+00:00
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME=ELVARQO

STAFF_ADMIN_ORIGIN=http://localhost:5173
STAFF_IDLE_SECONDS=1800
STAFF_ABSOLUTE_SECONDS=28800

# Select gd on shared hosting with GD JPEG/PNG/WebP enabled. Sharp remains the local default.
MEDIA_IMAGE_DRIVER=sharp
# Sharp responsive-image worker (Node.js 24+, backend/media npm ci)
MEDIA_NODE_BINARY=node

# Phase 6: sandbox only. Never put these in NEXT_PUBLIC_* or commit .env.
STOREFRONT_ORIGIN=http://localhost:3000
STRIPE_SANDBOX_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 7 uses local sandbox labels only. No courier API key or postage charges.
COURIER_SANDBOX_SCENARIO=normal
# Set a random secret of at least 32 characters to test signed sandbox tracking events.
COURIER_SANDBOX_WEBHOOK_SECRET=

# Wise GBP bank transfer: disabled until verified receiving details are supplied locally.
PAYMENT_PROVIDER=wise_bank_transfer
WISE_ENABLED=false
WISE_ACCOUNT_HOLDER=
WISE_SORT_CODE=
WISE_ACCOUNT_NUMBER=
WISE_PAYMENT_WINDOW_HOURS=24

# False: active published variants accept orders without counted inventory.
# True: enforce warehouse quantities and reservations. Never invent stock counts.
CATALOGUE_TRACK_STOCK=false
